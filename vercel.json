{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/news-style",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/news-style/:path*",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/user-style",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/user-style/:path*",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/chat-style",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/chat-style/:path*",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/archive/index",
      "destination": "/archive",
      "permanent": true
    },
    {
      "source": "/archive/:slug((?!.*\\.md$).*)",
      "destination": "/archive?page=:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/offline", "destination": "/offline.html" },
    { "source": "/chat", "destination": "/chat-style" },
    { "source": "/chat/:id", "destination": "/chat-style" },
    { "source": "/chat/:id/:thread", "destination": "/chat-style" },
    { "source": "/user/:id", "destination": "/user-style" },
    { "source": "/news/:id", "destination": "/news-style" },
    { "source": "/archive/assets/:path*", "destination": "/archive/assets/:path*" },
    { "source": "/archive/((?!.*\\.).*)", "destination": "/archive/index.html" }
  ]
}